            {t.label}
          </button>
        ))}
      </div>

      {tab === "staff" && <StaffSection />}
      {tab === "customers" && <CustomersTab />}
      {tab === "suppliers" && <SuppliersTab />}
      {tab === "owners" && <OwnersPartnersTab />}

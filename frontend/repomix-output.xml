@tailwind base;
@tailwind components;
@tailwind utilities;

html,
body,
#root {
  height: 100%;
}

/* =========================================================
   LIGHT THEME
   Based on the reference image
   ========================================================= */

:root {
  --color-bg: 227 232 251;
  --color-surface: 255 255 255;
  --color-surface-secondary: 246 247 252;

  --color-border: 226 228 238;
  --color-border-strong: 205 209 224;

  --color-text: 32 35 45;
  --color-muted: 116 121 138;

  --color-accent: 75 104 232;
  --color-accent-dark: 57 82 198;

  --color-positive: 48 158 105;
  --color-danger: 220 74 85;
  --color-warning: 226 166 53;

  --card-shadow:
    0 1px 2px rgb(20 25 50 / 0.04),
    0 8px 24px -12px rgb(30 40 90 / 0.16);
}


/* =========================================================
   DARK THEME
   ========================================================= */

.dark {
  --color-bg: 11 12 17;
  --color-surface: 23 26 35;
  --color-surface-secondary: 35 36 42;

  --color-border: 41 45 58;
  --color-border-strong: 58 63 79;

  --color-text: 244 245 250;
  --color-muted: 156 161 181;

  --color-accent: 75 104 232;
  --color-accent-dark: 62 86 205;

  --color-positive: 79 190 133;
  --color-danger: 235 91 103;
  --color-warning: 235 178 70;

  --card-shadow:
    0 1px 2px rgb(0 0 0 / 0.25),
    0 8px 24px -12px rgb(0 0 0 / 0.55);
}


/* =========================================================
   BODY
   ========================================================= */

body {
  background-color: rgb(var(--color-bg));
  color: rgb(var(--color-text));

  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;

  @apply antialiased transition-colors duration-200;
}


/* =========================================================
   CARDS
   ========================================================= */

.receipt-card {
  position: relative;

  background: rgb(var(--color-surface));

  border: 1px solid rgb(var(--color-border));

  box-shadow: var(--card-shadow);

  transition:
    box-shadow 150ms ease,
    border-color 150ms ease,
    transform 150ms ease;
}


/* Hover */

a.receipt-card:hover,
button.receipt-card:hover {
  border-color: rgb(var(--color-accent) / 0.45);

  box-shadow:
    0 1px 3px rgb(20 25 50 / 0.06),
    0 12px 28px -14px rgb(var(--color-accent) / 0.25);

  transform: translateY(-1px);
}


/* =========================================================
   RECEIPT TOP LINE
   ========================================================= */

.receipt-card::before {
  content: "";

  position: absolute;

  top: -1px;
  left: 1rem;
  right: 1rem;

  border-top: 2px dashed rgb(var(--color-border-strong));
}


/* =========================================================
   RECEIPT NOTCH
   ========================================================= */

.receipt-notch {
  position: absolute;

  top: -8px;

  width: 16px;
  height: 16px;

  border-radius: 9999px;

  background: rgb(var(--color-bg));

  border: 1px solid rgb(var(--color-border-strong));
}


/* =========================================================
   FOCUS
   ========================================================= */

:focus-visible {
  outline: 2px solid rgb(var(--color-accent));
  outline-offset: 2px;
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.001ms !important;
    transition-duration: 0.001ms !important;
  }

  a.receipt-card:hover,
  button.receipt-card:hover {
    transform: none;
  }
}

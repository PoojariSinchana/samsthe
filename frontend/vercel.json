{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-APP.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-APP.onrender.com/uploads/:path*" },
    { "source": "/((?!api/|uploads/|assets/|icons/).*)", "destination": "/index.html" }
  ]
}
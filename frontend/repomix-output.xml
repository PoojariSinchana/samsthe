        <nav
          className={`absolute left-0 top-0 flex h-full w-[80vw] max-w-72 flex-col bg-charcoal-light p-4 shadow-xl transition-transform duration-200 ease-out ${
            mobileOpen ? "translate-x-0" : "-translate-x-full"
